# -*- coding: utf-8 -*-
# pocket-bottom-cover-heft.FCMacro
#
# The laptop bottom cover (fit-critical 199.8 x 125.8 plateau, 6 screw holes)
# fused onto a wide, thick "heft" base that lowers the centre of mass and widens
# the footprint so a heavy top-flow cooler won't tip the machine over.
#
# Built as ONE parametric Part Design Body:
#   Sketch_Base    -> Pad "Base"        (wide heft slab, below the cover)
#   Sketch_Cover   -> Pad "Cover"       (fit-critical plateau that seats in the laptop)
#   FilletBottom   -> Fillet            (lap-contact edge)         [FILLETS toggle]
#   FilletTopLip   -> Fillet            (grip lip / shelf edge)    [FILLETS toggle]
#   Sketch_Screws  -> Pocket "Screws"   (6 holes through base+cover)
#   Sketch_Cbores  -> Pocket "Cbores"   (head recess in base bottom)
#   Sketch_Ballast -> Pocket "Ballast"  (pour-in ballast cavity)   [BALLAST toggle]
#   Sketch_Lid     -> Pocket "LidRebate"(flush lid ledge)          [BALLAST toggle]
#
# TWO OPTIONS with clear on/off switches:  FILLETS  and  BALLAST  (below).
#
# Print orientation: base flat on the bed (cover pointing up). The bottom fillet
# then sits on the bed -- if your slicer dislikes that, drop FILLET_BOTTOM to 0
# and use a chamfer, or print cover-down.

import math
import FreeCAD as App
import Part
import Sketcher

# ============================ PARAMETERS =====================================
# ---- fit-critical cover (do not change unless the laptop opening changes) ----
L        = 199.8     # cover length X (mm)
W        = 125.8     # cover width  Y (mm)
R        = 7.417     # cover corner radius
COVER_T  = 1.5       # cover thickness
HOLE_D   = 2.2       # screw hole diameter
HOLES = [(5.402,   5.402), (100.152, 5.402),   (194.852, 5.402),
         (5.402, 120.452), (100.152, 120.452), (194.852, 120.452)]

# ---- heft base ----
BASE_T      = 5.0    # base slab thickness (more = heavier + deeper ballast)
OVER_LR     = 20.0   # base overhang beyond cover, left & right each
OVER_FRONT  = 25.0   # base overhang beyond cover, front (-Y)
OVER_BACK   = 49.0   # base overhang beyond cover, back  (+Y, under the cooler)
BASE_R      = 10.0   # base corner radius (bigger than cover = comfier corners)

# ---- screw head recess in the base bottom (set CBORE_DEPTH=0 to skip) ----
CBORE_D     = 4.5
CBORE_DEPTH = 2.5

# ============================ OPTION 1: FILLETS ==============================
FILLETS       = True    # <<< on/off switch for the comfort fillets
FILLET_BOTTOM = 3.0     # bottom outer edge radius (rests on lap) -- the big win
FILLET_TOP    = 1.5     # top outer shelf-lip radius (where fingers lift it)

# ============================ OPTION 2: BALLAST =============================
BALLAST       = True    # <<< on/off switch for the pour-in ballast cavity
BALLAST_MARGIN= 10.0    # wall left between cavity and base edges
BALLAST_FLOOR = 1.2     # material left between cavity top and the cover
BALLAST_LID   = 1.5     # depth/thickness of the flush lid rebate
LID_LIP       = 2.0     # how far the lid ledge extends past the cavity wall
# Cavity defaults to the BACK shelf (clear of all screws, under the cooler).
# =============================================================================

bx0, bx1 = -OVER_LR, L + OVER_LR
by0, by1 = -OVER_FRONT, W + OVER_BACK

doc = App.newDocument("BottomCoverHeft")
body = doc.addObject("PartDesign::Body", "HeftBase")
V = App.Vector; Z = V(0, 0, 1)
xy = None
for f in body.Origin.OriginFeatures:
    if "XY" in f.Label or "XY" in f.Name:
        xy = f; break

def new_sketch(name, zoff=0.0):
    sk = doc.addObject("Sketcher::SketchObject", name); body.addObject(sk)
    if xy is not None:
        sk.AttachmentSupport = [(xy, "")]; sk.MapMode = "FlatFace"
        if zoff:
            pl = App.Placement(); pl.Base = V(0, 0, zoff); sk.AttachmentOffset = pl
    return sk

def add_rounded_rect(sk, x0, y0, x1, y1, r):
    i0 = sk.GeometryCount
    segs = [("line", V(x0+r,y0,0), V(x1-r,y0,0)), ("arc", V(x1-r,y0+r,0), -math.pi/2, 0.0),
            ("line", V(x1,y0+r,0), V(x1,y1-r,0)), ("arc", V(x1-r,y1-r,0), 0.0, math.pi/2),
            ("line", V(x1-r,y1,0), V(x0+r,y1,0)), ("arc", V(x0+r,y1-r,0), math.pi/2, math.pi),
            ("line", V(x0,y1-r,0), V(x0,y0+r,0)), ("arc", V(x0+r,y0+r,0), math.pi, 3*math.pi/2)]
    for s in segs:
        if s[0] == "line": sk.addGeometry(Part.LineSegment(s[1], s[2]), False)
        else: _, c, a0, a1 = s; sk.addGeometry(Part.ArcOfCircle(Part.Circle(c, Z, r), a0, a1), False)
    for k in range(8): sk.addConstraint(Sketcher.Constraint("Coincident", i0+k, 2, i0+(k+1)%8, 1))

def add_circles(sk, pts, dia):
    for (x, y) in pts: sk.addGeometry(Part.Circle(V(x, y, 0), Z, dia/2.0), False)

def pad(sketch, length, name, reversed=False):
    p = doc.addObject("PartDesign::Pad", name); p.Profile = sketch
    p.Length = length; p.Reversed = reversed
    body.addObject(p); doc.recompute(); return p

def pocket(sketch, length, name, reversed=False):
    p = doc.addObject("PartDesign::Pocket", name); p.Profile = sketch
    p.Length = length; p.Reversed = reversed
    body.addObject(p); doc.recompute(); return p

# ---- base slab (padded downward from XY) ----
sb = new_sketch("Sketch_Base", zoff=0.0)
add_rounded_rect(sb, bx0, by0, bx1, by1, BASE_R)
doc.recompute(); tip = pad(sb, BASE_T, "Base", reversed=True)   # z[-BASE_T, 0]

# ---- cover plateau (padded upward) ----
sc = new_sketch("Sketch_Cover", zoff=0.0)
add_rounded_rect(sc, 0, 0, L, W, R)
doc.recompute(); tip = pad(sc, COVER_T, "Cover")               # z[0, COVER_T]

# ---- fillets (done on the clean slab, before any holes) ----
def fillet_outer(name, zlvl, rad):
    global tip
    names = []
    for i, e in enumerate(tip.Shape.Edges):
        bb = e.BoundBox
        if abs(bb.ZMin-zlvl) < 1e-3 and abs(bb.ZMax-zlvl) < 1e-3:
            if (abs(bb.XMin-bx0) < 1e-2 or abs(bb.XMax-bx1) < 1e-2 or
                abs(bb.YMin-by0) < 1e-2 or abs(bb.YMax-by1) < 1e-2):
                names.append("Edge%d" % (i+1))
    if not names:
        App.Console.PrintWarning("%s: no matching edges, skipped.\n" % name); return
    try:
        f = doc.addObject("PartDesign::Fillet", name)
        f.Base = (tip, names); f.Radius = rad
        body.addObject(f); doc.recompute(); tip = f
    except Exception as ex:
        App.Console.PrintWarning("%s failed (%s) - lower the radius or fillet by "
                                 "hand.\n" % (name, str(ex)[:50]))

if FILLETS:
    fillet_outer("FilletBottom", -BASE_T, FILLET_BOTTOM)
    fillet_outer("FilletTopLip", 0.0,     FILLET_TOP)

# ---- screw holes: through base + cover (sketch on top face, cut down) ----
ss = new_sketch("Sketch_Screws", zoff=COVER_T); add_circles(ss, HOLES, HOLE_D)
doc.recompute(); tip = pocket(ss, BASE_T + COVER_T + 1.0, "Screws")   # cuts -Z

# ---- counterbores: head recess in the base underside ----
if CBORE_DEPTH > 0:
    cb = new_sketch("Sketch_Cbores", zoff=-BASE_T); add_circles(cb, HOLES, CBORE_D)
    doc.recompute(); tip = pocket(cb, CBORE_DEPTH, "Cbores", reversed=True)  # cut +Z

# ---- ballast cavity + flush lid rebate (back shelf) ----
if BALLAST:
    cx0, cx1 = bx0 + BALLAST_MARGIN, bx1 - BALLAST_MARGIN
    cy0, cy1 = W + 3.0, by1 - BALLAST_MARGIN
    depth = BASE_T - BALLAST_FLOOR
    cav = new_sketch("Sketch_Ballast", zoff=-BASE_T)
    add_rounded_rect(cav, cx0, cy0, cx1, cy1, 6.0)
    doc.recompute(); tip = pocket(cav, depth, "Ballast", reversed=True)
    lid = new_sketch("Sketch_Lid", zoff=-BASE_T)
    add_rounded_rect(lid, cx0-LID_LIP, cy0-LID_LIP, cx1+LID_LIP, cy1+LID_LIP, 7.0)
    doc.recompute(); tip = pocket(lid, BALLAST_LID, "LidRebate", reversed=True)

body.Tip = tip
doc.recompute()
try:
    import FreeCADGui as Gui
    Gui.activeDocument().activeView().viewIsometric(); Gui.SendMsgToActiveView("ViewFit")
except Exception:
    pass

msg = ("\nHeft base built: %.0f x %.0f mm footprint, %.1f mm base + %.1f mm cover.\n"
       "  FILLETS: %s   BALLAST: %s\n"
       "  Screws now span base+cover -- use ~%.0f mm+ M2 screws (was %.1f mm).\n"
       % (bx1-bx0, by1-by0, BASE_T, COVER_T,
          "ON" if FILLETS else "off", "ON" if BALLAST else "off",
          BASE_T+COVER_T+4, COVER_T))
if BALLAST:
    cav_cc = (bx1-bx0-2*BALLAST_MARGIN)*(by1-W-3.0-BALLAST_MARGIN)*(BASE_T-BALLAST_FLOOR)/1000.0
    msg += ("  Ballast cavity ~%.0f cm3: ~%.0f g steel shot or ~%.0f g sand.\n"
            % (cav_cc, cav_cc*4.5, cav_cc*1.6))
App.Console.PrintMessage(msg)
